---
import { translations, defaultLocale, type Locale } from "@/i18n";
const { lang } = Astro.props;
const locale: Locale = (lang as Locale) ?? defaultLocale;
const t = translations[locale];
const music = t.music;
---
<section class="py-24 md:py-32 bg-c8-black border-y border-white/5 relative">
  <div class="absolute inset-0 opacity-[0.02]" style="background-image: radial-gradient(#35FC03 1px, transparent 1px); background-size: 24px 24px;"></div>
  <div class="container mx-auto px-6 lg:px-12 max-w-4xl text-center relative z-10">
    <span class="font-mono text-c8-green text-xs tracking-widest uppercase mb-6 block reveal">// THE CHALLENGE</span>
    <h2 class="reveal reveal-delay-1 font-extmkt-display text-3xl md:text-5xl font-bold text-white mb-8 leading-tight">
      {music.problem.headline}
    </h2>
    <p class="reveal reveal-delay-2 text-xl text-c8-muted leading-relaxed">
      {music.problem.copy}
    </p>
  </div>
</section>