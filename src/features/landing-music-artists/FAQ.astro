---
import { translations, defaultLocale, type Locale } from "@/i18n";
const { lang } = Astro.props;
const locale: Locale = (lang as Locale) ?? defaultLocale;
const t = translations[locale];
const music = t.music;
const faqs = [
  { q: music.faq.q1, a: music.faq.a1 },
  { q: music.faq.q2, a: music.faq.a2 },
  { q: music.faq.q3, a: music.faq.a3 },
  { q: music.faq.q4, a: music.faq.a4 },
  { q: music.faq.q5, a: music.faq.a5 },
];
---
<section class="py-24 md:py-32 bg-extmkt-creamDark border-t border-white/5">
  <div class="container mx-auto px-6 lg:px-12 max-w-3xl">
    <div class="text-center mb-16 reveal">
      <span class="font-mono text-extmkt-forestDark text-xs tracking-widest uppercase mb-4 block">// CLARITY</span>
      <h2 class="font-extmkt-display text-3xl md:text-4xl font-bold text-c8-surface">
        {music.faq.headline}
      </h2>
    </div>
    <div class="space-y-4">
      {faqs.map((faq, i) => (
        <details class="reveal reveal-delay-{i} group bg-c8-black border border-white/10 rounded-sm open:border-c8-green/30 transition-all duration-300">
          <summary class="flex justify-between items-center p-6 cursor-pointer list-none text-white font-bold focus:outline-none focus:ring-2 focus:ring-c8-green/50 rounded-sm">
            <span class="pr-4">{faq.q}</span>
            <span class="transition-transform duration-300 group-open:rotate-45 text-c8-green text-2xl font-light flex-shrink-0">+</span>
          </summary>
          <div class="px-6 pb-6 text-c8-muted leading-relaxed border-t border-white/5 pt-4">
            {faq.a}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>