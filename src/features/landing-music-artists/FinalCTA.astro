---
import { C8 } from "@/config";
import { translations, defaultLocale, type Locale } from "@/i18n";

const { lang } = Astro.props;
const locale: Locale = (lang as Locale) ?? defaultLocale;
const t = translations[locale];
const music = t.music;
const whatsappUrl = C8.whatsapp.getUrl(locale === 'en' ? "Hi, I'm ready to talk about my music project." : "Hola, estoy listo para hablar de mi proyecto musical.");
---
<section id="contact" class="py-24 md:py-32 bg-c8-black relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-c8-deep to-c8-black opacity-80"></div>
  <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(#35FC03 1px, transparent 1px), linear-gradient(90deg, #35FC03 1px, transparent 1px); background-size: 60px 60px;"></div>
  
  <div class="container mx-auto px-6 lg:px-12 relative z-10 text-center max-w-4xl">
    <div class="reveal mb-8">
      <span class="inline-block w-16 h-[1px] bg-c8-green mb-6"></span>
      <h2 class="font-extmkt-display text-4xl md:text-6xl font-bold text-white mb-6 leading-tight">
        {music.cta.headline}
      </h2>
    </div>
    
    <p class="reveal reveal-delay-1 text-xl text-c8-muted mb-12 leading-relaxed max-w-2xl mx-auto">
      {music.cta.copy}
    </p>
    
    <div class="reveal reveal-delay-2 flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener"
        data-cta="consultation"
        data-location="music_final_cta"
        class="group inline-flex items-center justify-center gap-3 bg-c8-green text-c8-black px-10 py-5 text-lg font-bold rounded-sm hover:bg-white transition-all duration-300 shadow-[0_0_30px_-5px_rgba(53,252,3,0.3)] hover:shadow-[0_0_40px_-5px_rgba(53,252,3,0.5)]"
      >
        {music.cta.cta_primary}
        <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <!-- 
      <a
        href="https://neon-pulse-revamp.netlify.app/"
        target="_blank"
        rel="noopener noreferrer"
        data-cta="neon_pulse"
        data-location="music_final_cta_secondary"
        class="group inline-flex items-center justify-center gap-3 border border-white/20 text-white px-10 py-5 text-lg font-bold rounded-sm hover:border-c8-green hover:text-c8-green transition-all duration-300 backdrop-blur-sm"
      >
        {music.cta.cta_secondary}
        <svg class="w-5 h-5 transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" viewBox="0 0 24 24" fill="none"><path d="M7 17L17 7M17 7H7M17 7V17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      -->
    </div>
  </div>
</section>