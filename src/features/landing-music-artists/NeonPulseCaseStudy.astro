---
import { translations, defaultLocale, type Locale } from "@/i18n";

const { lang } = Astro.props;
const locale: Locale = (lang as Locale) ?? defaultLocale;
const t = translations[locale];
const music = t.music;
---
<section class="py-24 md:py-32 bg-c8-deep relative overflow-hidden">
  <div class="absolute top-0 right-0 w-1/3 h-full bg-c8-green/5 blur-[120px] rounded-full pointer-events-none"></div>
  
  <div class="container mx-auto px-6 lg:px-12 relative z-10">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Text Content -->
      <div class="lg:col-span-5 reveal">
        <div class="flex items-center gap-3 mb-6">
          <span class="w-8 h-[1px] bg-c8-green"></span>
          <span class="font-mono text-c8-gray text-xs tracking-widest uppercase">Proof of Concept</span>
        </div>
        
        <h2 class="font-extmkt-display text-3xl md:text-4xl lg:text-5xl font-bold text-c8-black mb-6 leading-tight">
          {music.neon.headline}
        </h2>
        
        <p class="text-c8-gray mb-6 leading-relaxed text-lg">
          {music.neon.copy}
        </p>
        
        <div class="bg-c8-black border border-white/10 rounded-sm p-6 mb-8">
          <h4 class="font-mono text-xs text-c8-green uppercase tracking-wider mb-3">Technical Highlights</h4>
          <ul class="space-y-2 text-sm text-c8-muted">
            <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-c8-green rounded-full"></span> Artist-focused responsive web design</li>
            <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-c8-green rounded-full"></span> Semantic HTML & performance optimization</li>
            <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-c8-green rounded-full"></span> Dynamic gig listings via Google Sheets</li>
            <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-c8-green rounded-full"></span> Integrated booking & contact workflows</li>
          </ul>
        </div>

        <a 
          href="https://neon-pulse-revamp.netlify.app/" 
          target="_blank" 
          rel="noopener noreferrer"
          data-cta="neon_pulse"
          data-location="neon_section"
          class="group inline-flex items-center gap-3 bg-black text-white px-8 py-4 font-bold rounded-sm hover:bg-c8-green transition-all duration-300"
        >
          {music.neon.cta}
          <svg class="w-5 h-5 transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" viewBox="0 0 24 24" fill="none"><path d="M7 17L17 7M17 7H7M17 7V17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <p class="text-xs text-c8-muted mt-4 font-mono">{music.neon.disclaimer}</p>
      </div>

      <!-- Browser Mockup -->
      <div class="lg:col-span-7 reveal reveal-delay-1">
        <div class="relative group">
          <div class="absolute -inset-4 bg-c8-green/10 blur-2xl rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
          
          <div class="relative bg-c8-surface rounded-lg border border-white/10 overflow-hidden shadow-2xl">
            <!-- Browser Chrome -->
            <div class="bg-c8-black px-4 py-3 flex items-center gap-3 border-b border-white/10">
              <div class="flex gap-2">
                <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
                <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
                <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
              </div>
              <div class="flex-1 bg-c8-surface rounded px-3 py-1.5 text-xs text-c8-muted font-mono flex items-center justify-center gap-2">
                <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                neon-pulse-revamp.netlify.app
              </div>
            </div>
            
            <!-- Mockup Content (Abstract representation) -->
            <div class="aspect-[16/10] bg-c8-black relative overflow-hidden group">
              <div class="absolute inset-0 flex flex-col">
                 <img 
                src="/img/neonpulse-ss.webp" 
                alt="Neon Pulse official website screenshot showing responsive artist-focused design" 
                class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-[1.02]"
                loading="lazy"
                decoding="async"
              />
              <!-- Subtle overlay to ensure text readability if needed, and blend with dark theme -->
              <div class="absolute inset-0 ring-1 ring-inset ring-white/10 rounded-b-lg pointer-events-none"></div>
              </div>
              
              <div class="absolute top-4 right-4 bg-c8-green text-c8-black text-[10px] font-bold font-mono px-3 py-1 rounded-sm uppercase tracking-wider">
                Live Preview
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>