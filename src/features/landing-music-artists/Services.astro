---
import { translations, defaultLocale, type Locale } from "@/i18n";

const { lang } = Astro.props;
const locale: Locale = (lang as Locale) ?? defaultLocale;
const t = translations[locale];
const music = t.music;

const services = [
  { num: "01", title: music.services.s1_title, desc: music.services.s1_desc },
  { num: "02", title: music.services.s2_title, desc: music.services.s2_desc },
  { num: "03", title: music.services.s3_title, desc: music.services.s3_desc },
  { num: "04", title: music.services.s4_title, desc: music.services.s4_desc },
  { num: "05", title: music.services.s5_title, desc: music.services.s5_desc },
  { num: "06", title: music.services.s6_title, desc: music.services.s6_desc },
];
---
<section id="services" class="py-24 md:py-32 bg-c8-black relative">
  <div class="container mx-auto px-6 lg:px-12">
    <div class="max-w-4xl mb-16 reveal">
      <span class="font-mono text-c8-green text-xs tracking-widest uppercase mb-4 block">// CORE CAPABILITIES</span>
      <h2 class="font-extmkt-display text-4xl md:text-5xl font-bold text-white leading-tight">
        {music.services.headline}
      </h2>
    </div>

    <div class="space-y-0 border-t border-white/10">
      {services.map((service, index) => (
        <div class="group grid md:grid-cols-12 gap-6 py-10 border-b border-white/10 hover:bg-white/[0.02] transition-colors duration-300 reveal reveal-delay-{index % 3}">
          <div class="md:col-span-2 flex items-start">
            <span class="font-mono text-3xl md:text-4xl text-c8-green/50 group-hover:text-c8-green transition-colors duration-300">
              {service.num}
            </span>
          </div>
          <div class="md:col-span-10">
            <h3 class="font-extmkt-display text-2xl md:text-3xl font-bold text-white mb-3 group-hover:text-c8-green transition-colors duration-300">
              {service.title}
            </h3>
            <p class="text-c8-muted text-lg leading-relaxed max-w-3xl">
              {service.desc}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>