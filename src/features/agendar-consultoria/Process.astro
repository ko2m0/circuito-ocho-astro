---
const steps = [
    {
        num: "01",
        title: "Entendemos dónde estás",
        description: "Revisamos brevemente tu negocio, tus objetivos y cómo estás generando oportunidades actualmente."
    },
    {
        num: "02",
        title: "Detectamos puntos de fuga",
        description: "Identificamos problemas evidentes en tu ecosistema digital: campañas, sitio, contenido, medición o proceso comercial."
    },
    {
        num: "03",
        title: "Definimos qué revisar primero",
        description: "Te damos una lectura inicial y determinamos cuáles serían los siguientes puntos que tendría sentido trabajar."
    }
];
---

<section id="proceso" class="bg-card border-b border-line py-20 md:py-28">
    <div class="max-w-3xl mx-auto px-6 md:px-12">

        <p class="font-mono text-xs uppercase tracking-[0.2em] text-forest mb-4 reveal">
            El proceso
        </p>

        <h2 class="font-display text-4xl md:text-5xl tracking-tight mb-14 reveal reveal-delay-1">
            Qué pasa en la consultoría
        </h2>

        <div class="space-y-10">
            {steps.map((step, i) => (
                <div class={`grid grid-cols-[auto_1fr] gap-6 md:gap-8 reveal reveal-delay-${i + 1}`}>
                    <div class="font-mono text-sm text-forest font-bold pt-1.5">
                        {step.num}
                    </div>
                    <div class="border-l border-line pl-6 md:pl-8">
                        <h3 class="font-display text-2xl md:text-3xl mb-3 tracking-tight">
                            {step.title}
                        </h3>
                        <p class="font-body text-base md:text-lg text-inkSoft leading-relaxed">
                            {step.description}
                        </p>
                    </div>
                </div>
            ))}
        </div>

    </div>
</section>