---
import { C8 } from "@/config";

// TODO: Replace with your actual Cal.com username/team and event type
const calLink = "tu-usuario/consultoria-30-min"; 

const whatsappUrl = C8.whatsapp.getUrl("Hola, vi la página de consultoría y prefiero coordinar por WhatsApp.");
---

<!-- ============ CONSULTATION CALENDAR SECTION ============ -->
<section id="formulario" class="py-20 md:py-28 px-6 lg:px-12 border-t border-extmkt-line bg-extmkt-cream text-extmkt-ink">
  <div class="max-w-350 mx-auto">
    <div class="grid lg:grid-cols-12 gap-12">
      
      <!-- LEFT COLUMN: Context & WhatsApp Alternative -->
      <div class="lg:col-span-5 reveal">
        <span class="urgency-badge inline-flex items-center gap-2 text-extmkt-cream text-xs font-mono tracking-wider uppercase px-4 py-2 rounded-sm mb-6 bg-extmkt-forest">
          <span class="w-2 h-2 bg-extmkt-sage rounded-full animate-pulse"></span>
          Consultoría gratuita · 30 minutos
        </span>
        
        <h2 class="font-extmkt-display text-3xl md:text-4xl leading-[1.1] mb-6">
          Hablemos de tu marketing.
        </h2>
        
        <p class="text-lg text-extmkt-inkSoft leading-relaxed mb-8">
          Sin pitch eterno. Sin compromiso. Primero entendemos tu situación, después vemos si tiene sentido trabajar juntos.
        </p>
        
        <div class="space-y-4 mb-10">
          <div class="flex items-start gap-3">
            <span class="font-extmkt-display text-xl text-extmkt-forest">→</span>
            <p class="text-extmkt-inkSoft">Entendemos dónde estás y tus objetivos actuales.</p>
          </div>
          <div class="flex items-start gap-3">
            <span class="font-extmkt-display text-xl text-extmkt-forest">→</span>
            <p class="text-extmkt-inkSoft">Detectamos puntos de fuga en tu ecosistema digital.</p>
          </div>
          <div class="flex items-start gap-3">
            <span class="font-extmkt-display text-xl text-extmkt-forest">→</span>
            <p class="text-extmkt-inkSoft">Definimos qué tiene sentido revisar primero.</p>
          </div>
        </div>

        <div class="pt-8 border-t border-extmkt-line">
          <p class="text-sm text-extmkt-muted mb-3 font-medium">¿Prefieres coordinar manualmente?</p>
          <a
            data-track="whatsapp_click"
            data-location="consultation_form_alt"
            href={whatsappUrl} 
            target="_blank" 
            rel="noopener" 
            class="btn-whatsapp inline-flex items-center gap-2 bg-[#25D366] text-white px-6 py-3 text-sm font-medium rounded-sm hover:bg-[#22c55e] transition-all"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            Hablar por WhatsApp ahora
          </a>
        </div>
      </div>

      <!-- RIGHT COLUMN: Cal.com Inline Embed -->
      <div class="lg:col-span-6 lg:col-start-7 reveal reveal-delay-1">
        
        <!-- Calendar Container -->
        <!-- Added min-height so it doesn't collapse while the iframe loads -->
        <div class="bg-extmkt-card text-extmkt-ink p-2 rounded-sm border border-extmkt-line overflow-hidden" style="min-height: 650px;">
          
          <!-- REMOVED data-cal-link to prevent the popup behavior -->
          <div 
            id="my-cal-inline" 
            style="width: 100%; height: 100%; min-height: 650px;"
          ></div>
          
        </div>

        <!-- Cal.com Official Inline Script -->
        <script is:inline>
          (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; typeof namespace === "string"?(cal.ns[namespace] = api)&&p(api, ar):p(cal, ar); return; } p(cal, ar); }; })(window, "https://cal.com/embed/embed.js", "Cal");
          
          Cal("init", {origin: "https://cal.com"});
          
          // Render inline calendar
          Cal("inline", {
            elementOrSelector: "#my-cal-inline",
            calLink: "circuito-ocho/diagnostico-digital", 
            layout: "month_view"
          });
        </script>

      </div>
    </div>
  </div>
</section>