---
import { C8 } from "@/config";
const whatsappUrl = C8.whatsapp.getUrl();

// Detect if we are on the consultation page
const isConsultationPage = Astro.url.pathname.includes('/agendar-consultoria');

// Set logo link based on current page
const logoLink = isConsultationPage ? '/services/external-marketing-department' : '/services/external-marketing-department';

---

<!-- ============ HEADER ============ -->
<header id="header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="max-w-350 mx-auto px-6 lg:px-12 py-4 flex items-center justify-between">
    <a href={logoLink} class="flex items-center gap-2.5" aria-label="Circuito Ocho - Inicio">
      <img src="/img/C8_logo0626_wF1.svg" alt="Circuito Ocho Logo" class="h-12 w-12">
            <span class="font-extmkt-display text-l lg:text-xl tracking-tight ">{C8.company.brandName}</span>
    </a>

 <!-- NAVIGATION / BUTTONS: Only show if NOT on the consultation page -->
    {!isConsultationPage && (
      <nav class="flex items-center gap-4">
        <a 
          href={whatsappUrl}
          target="_blank" 
          rel="noopener"
          class="hidden md:inline-flex btn-whatsapp items-center gap-2 bg-[#25D366] text-white px-5 py-2.5 text-sm font-medium rounded-sm"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          WhatsApp
        </a>
        <a
          href="#" 
          data-cal-link="circuito-ocho/diagnostico-digital"
          data-cal-namespace="diagnostico-digital"
          data-cal-config='{"layout":"month_view","useSlotsViewOnSmallScreen":"true"}'
          class="btn-primary inline-flex items-center gap-2 bg-extmkt-forest text-extmkt-cream px-5 py-2.5 text-sm font-medium rounded-sm hover:bg-extmkt-forestDark transition-all"
        >
          Agendar consultoría gratuita
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        </a>
      </nav>
    )}


    
  </div>
</header>

<!-- Cal element-click embed code begins -->
