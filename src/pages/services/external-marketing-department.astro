---
import "@/styles/tailwind.css";
import "@/features/landing-external-marketing/styles/landing.css";

import LandingLayout from "@/layouts/LandingLayout.astro";

import Header from "@/features/landing-external-marketing/Header.astro";
import Hero from "@/features/landing-external-marketing/Hero.astro";
import Trustbar from "@/features/landing-external-marketing/Trustbar.astro";
import Problem from "@/features/landing-external-marketing/Problem.astro";
import Solution from "@/features/landing-external-marketing/Solution.astro";
import Comparison from "@/features/landing-external-marketing/Comparison.astro";
import Testimonials from "@/features/landing-external-marketing/Testimonials.astro";
import FAQ from "@/features/landing-external-marketing/FAQ.astro";
import CTA from "@/features/landing-external-marketing/CTA.astro";
import Footer from "@/features/landing-external-marketing/Footer.astro";

import { C8 } from "@/config";
---

<LandingLayout
    lang="es"
    title="Departamento Externo de Marketing | Circuito Ocho"
    description="Contrata un departamento externo de marketing en lugar de una agencia tradicional."
    canonical="https://circuitoocho.com/services/external-marketing-department"
>


    <Header />
<main>
    <Hero />
    <Trustbar />
    <Problem />
    <Solution />
    <Comparison />
    <Testimonials />
    <FAQ />
    <CTA />
</main>
    <Footer />

</LandingLayout>

<script>
  import "@/features/landing-external-marketing/scripts/landing";
</script>
<script>
    import "@/features/landing-external-marketing/scripts/footermodals"
</script>