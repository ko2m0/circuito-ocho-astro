---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Problems from '../components/Problems.astro';
import System from '../components/System.astro';
import Services from '../components/Services.astro';
import Testimonials from '../components/Testimonials.astro';
import Process from '../components/Process.astro';
import Pricing from '../components/Pricing.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
    <Header />
    <!-- Hero Section -->
    <Hero />
    <!-- Problem Section -->
    <Problems />
    <!-- System Section -->
    <System />
    <!-- Services Section -->
    <Services />
    <!-- Testimonials Section -->
    <Testimonials />
    <!-- Process Section (Zigzag) -->
    <Process />
    <!-- Pricing Section -->
    <Pricing />
    <!-- Contact Section -->
    <Contact />
    <!-- Footer Section -->
    <Footer />

    <!-- Floating Action Buttons -->
    <div class="fixed bottom-6 right-6 fab-container z-40">
        <a href="https://wa.me/5217701540400" target="_blank" rel="noopener" class="block w-14 h-14 bg-green-500 rounded-full items-center justify-center shadow-lg hover:bg-green-600 transition-all mb-4 flex">
            <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            
        </a>
        <button id="scroll-to-top" class="w-14 h-14 bg-c8-green rounded-full flex items-center justify-center shadow-lg hover:bg-white transition-all opacity-0 pointer-events-none">
            <svg class="w-6 h-6 text-c8-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
            </svg>
        </button>
    </div>

 <script is:inline>
        (function() {
            // Mobile Menu with body scroll lock
            var mobileMenuBtn = document.getElementById('mobile-menu-btn');
            var mobileMenu = document.getElementById('mobile-menu');
            var body = document.body;

            if (mobileMenuBtn && mobileMenu) {
                mobileMenuBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    var isOpen = mobileMenu.classList.contains('opacity-100');
                    if (isOpen) {
                        mobileMenu.classList.remove('opacity-100', 'pointer-events-auto');
                        mobileMenu.classList.add('opacity-0', 'pointer-events-none');
                        body.style.overflow = '';
                    } else {
                        mobileMenu.classList.remove('opacity-0', 'pointer-events-none');
                        mobileMenu.classList.add('opacity-100', 'pointer-events-auto');
                        body.style.overflow = 'hidden';
                    }
                });

                var menuLinks = mobileMenu.querySelectorAll('.mobile-menu-link');
                for (var i = 0; i < menuLinks.length; i++) {
                    menuLinks[i].addEventListener('click', function() {
                        mobileMenu.classList.remove('opacity-100', 'pointer-events-auto');
                        mobileMenu.classList.add('opacity-0', 'pointer-events-none');
                        body.style.overflow = '';
                    });
                }
            }

            // Scroll to Top Button
            var scrollToTopBtn = document.getElementById('scroll-to-top');
            if (scrollToTopBtn) {
                window.addEventListener('scroll', function() {
                    if (window.pageYOffset > 300) {
                        scrollToTopBtn.classList.add('visible');
                    } else {
                        scrollToTopBtn.classList.remove('visible');
                    }
                });

                scrollToTopBtn.addEventListener('click', function() {
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                });
            }

            // Reveal on Scroll
            var revealElements = document.querySelectorAll('.reveal-element');
            var revealOnScroll = function() {
                for (var i = 0; i < revealElements.length; i++) {
                    var element = revealElements[i];
                    var elementTop = element.getBoundingClientRect().top;
                    if (elementTop < window.innerHeight - 100) {
                        element.classList.add('visible');
                    }
                }
            };
            window.addEventListener('scroll', revealOnScroll);
            revealOnScroll();

            // Privacy Modal
            var privacyModal = document.getElementById('privacy-modal');
            var closePrivacy = document.getElementById('close-privacy');
            var privacyLink = document.querySelector('a[href="#privacy"]');

            if (privacyLink && privacyModal) {
                privacyLink.addEventListener('click', function(e) {
                    e.preventDefault();
                    privacyModal.classList.remove('hidden');
                    body.style.overflow = 'hidden';
                });
            }
            if (closePrivacy && privacyModal) {
                closePrivacy.addEventListener('click', function() {
                    privacyModal.classList.add('hidden');
                    body.style.overflow = '';
                });
                privacyModal.addEventListener('click', function(e) {
                    if (e.target === privacyModal) {
                        privacyModal.classList.add('hidden');
                        body.style.overflow = '';
                    }
                });
            }

            // Terms Modal
            var termsModal = document.getElementById('terms-modal');
            var closeTerms = document.getElementById('close-terms');
            var termsLink = document.querySelector('a[href="#terms"]');

            if (termsLink && termsModal) {
                termsLink.addEventListener('click', function(e) {
                    e.preventDefault();
                    termsModal.classList.remove('hidden');
                    body.style.overflow = 'hidden';
                });
            }
            if (closeTerms && termsModal) {
                closeTerms.addEventListener('click', function() {
                    termsModal.classList.add('hidden');
                    body.style.overflow = '';
                });
                termsModal.addEventListener('click', function(e) {
                    if (e.target === termsModal) {
                        termsModal.classList.add('hidden');
                        body.style.overflow = '';
                    }
                });
            }

            // Neural Particle Background
            var canvas = document.getElementById('bg-canvas');
            if (canvas) {
                var ctx = canvas.getContext('2d');
                var width, height;
                var particles = [];
                var particleCount = 80;
                var connectionDistance = 150;

                function resize() {
                    width = canvas.width = window.innerWidth;
                    height = canvas.height = window.innerHeight;
                }
                resize();
                window.addEventListener('resize', resize);

                function Particle() {
                    this.x = Math.random() * width;
                    this.y = Math.random() * height;
                    this.vx = (Math.random() - 0.5) * 0.3;
                    this.vy = (Math.random() - 0.5) * 0.3;
                    this.radius = Math.random() * 1.5 + 0.5;
                }

                Particle.prototype.update = function() {
                    this.x += this.vx;
                    this.y += this.vy;
                    if (this.x < 0 || this.x > width) this.vx *= -1;
                    if (this.y < 0 || this.y > height) this.vy *= -1;
                };

                Particle.prototype.draw = function() {
                    ctx.beginPath();
                    ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
                    ctx.fillStyle = 'rgba(53, 252, 3, 0.8)';
                    ctx.fill();
                };

                for (var i = 0; i < particleCount; i++) {
                    particles.push(new Particle());
                }

                function connectParticles() {
                    for (var i = 0; i < particles.length; i++) {
                        for (var j = i + 1; j < particles.length; j++) {
                            var dx = particles[i].x - particles[j].x;
                            var dy = particles[i].y - particles[j].y;
                            var distance = Math.sqrt(dx * dx + dy * dy);
                            if (distance < connectionDistance) {
                                var opacity = 0.25 * (1 - distance / connectionDistance);
                                ctx.beginPath();
                                ctx.moveTo(particles[i].x, particles[i].y);
                                ctx.lineTo(particles[j].x, particles[j].y);
                                ctx.strokeStyle = 'rgba(53, 252, 3, ' + opacity + ')';
                                ctx.lineWidth = 0.6;
                                ctx.stroke();
                            }
                        }
                    }
                }

                function animate() {
                    ctx.clearRect(0, 0, width, height);
                    for (var i = 0; i < particles.length; i++) {
                        particles[i].update();
                        particles[i].draw();
                    }
                    connectParticles();
                    requestAnimationFrame(animate);
                }

                animate();
            }
        })();
    </script>
</Layout>