---
import { C8 } from "@/config";

import {
  translations,
  defaultLocale,
  type Locale
} from "@/i18n";

const locale: Locale = (Astro.props.lang as Locale) ?? defaultLocale;
const t = translations[locale];
---

<footer class="bg-c8-dark border-t border-c8-green/20 py-12 relative z-10">
    <div class="container mx-auto px-6">
        <div class="max-w-6xl mx-auto">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
                <div class="mb-6 md:mb-0">
                    <img src="/img/C8_logo0626_F4.png" alt="Circuito Ocho Logo" class="h-12 mb-4">
                    <div class="flex space-x-4 mb-4">
                        <a href={C8.social.linkedin} class="text-gray-400 hover:text-c8-green transition-colors" aria-label="LinkedIn">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                        </a>
                        <a href={C8.social.facebook} class="text-gray-400 hover:text-c8-green transition-colors" aria-label="Facebook">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                        </a>
                    </div>
                    <p class="text-gray-400 text-sm">© 2026 {t.footer.rights} .</p>
                    <p class="text-gray-500 text-xs mt-2">Website made with ♥ and pride by Ko2m0</p>
                </div>
                <div class="flex flex-col md:flex-row space-y-2 md:space-y-0 md:space-x-6">
                    <a href="#privacy" class="text-gray-400 hover:text-c8-green transition-colors text-sm">{t.footer.privacy_title}</a>
                    <a href="#terms" class="text-gray-400 hover:text-c8-green transition-colors text-sm">{t.footer.terms_title}</a>
                </div>
            </div>
        </div>
    </div>
</footer>

<!-- Privacy Policy Modal -->
<div id="privacy-modal" class="hidden fixed inset-0 bg-black/80 z-[60] flex items-center justify-center p-6">
    <div class="bg-c8-dark border border-c8-green/30 rounded-lg max-w-4xl max-h-[90vh] overflow-y-auto p-8">
        <div class="flex justify-between items-center mb-6">
            <h2 class="text-3xl font-bold text-c8-green">{t.footer.privacy_title}</h2>
            <button id="close-privacy" class="text-gray-400 hover:text-white text-2xl">&times;</button>
        </div>
        <div class="text-gray-300 space-y-4">
            <p>{t.footer.privacy_p1}</p>
            <h3 class="text-xl font-bold text-white mt-6">{t.footer.privacy_h3_1}</h3>
            <p>{t.footer.privacy_p2}</p>
            <h3 class="text-xl font-bold text-white mt-6">{t.footer.privacy_h3_2}</h3>
            <ul class="list-disc list-inside space-y-2">
                <li>Proveer, operar y mantener nuestro Servicio.</li>
                <li>Mejorar, personalizar y expandir nuestro contenido.</li>
                <li>Comunicarnos con usted para fines de soporte, actualización o marketing (con su consentimiento).</li>
                <li>Enviarle correos electrónicos relacionados con auditorías o propuestas.</li>
                <li>Prevenir actividades fraudulentas y cumplir con obligaciones legales.</li>
            </ul>
            <h3 class="text-xl font-bold text-white mt-6">3. Cookies y Tecnologías Similares</h3>
            <p>Utilizamos cookies esenciales para el funcionamiento del sitio y cookies analíticas (como Google Analytics) para entender el tráfico de usuarios. Puede configurar su navegador para rechazar cookies, aunque esto podría afectar ciertas funcionalidades del sitio.</p>
            <h3 class="text-xl font-bold text-white mt-6">4. Compartición de Datos</h3>
            <p>No vendemos ni alquilamos su información personal a terceros. Podemos compartir datos con proveedores de confianza que nos ayudan a operar el sitio (ej. servicios de alojamiento, email marketing) bajo estrictos acuerdos de confidencialidad.</p>
            <h3 class="text-xl font-bold text-white mt-6">5. Sus Derechos</h3>
            <p>Usted tiene derecho a acceder, corregir, eliminar o restringir el procesamiento de sus datos personales. Para ejercer estos derechos, contáctenos a través del formulario de contacto o escriba a privacidad@circuitoocho.com.</p>
            <h3 class="text-xl font-bold text-white mt-6">6. Cambios en este Protocolo</h3>
            <p>Nos reservamos el derecho de actualizar esta política en cualquier momento. Publicaremos cambios notables en esta página y actualizaremos la fecha de "Última actualización" en la parte inferior.</p>
            <p class="text-sm text-gray-400 mt-6">Última actualización: 10 de Abril de 2026</p>
        </div>
    </div>
</div>

<!-- Terms Modal -->
<div id="terms-modal" class="hidden fixed inset-0 bg-black/80 z-[60] flex items-center justify-center p-6">
    <div class="bg-c8-dark border border-c8-green/30 rounded-lg max-w-4xl max-h-[90vh] overflow-y-auto p-8">
        <div class="flex justify-between items-center mb-6">
            <h2 class="text-3xl font-bold text-c8-green">Términos de Servicio</h2>
            <button id="close-terms" class="text-gray-400 hover:text-white text-2xl">&times;</button>
        </div>
        <div class="text-gray-300 space-y-4">
            <p>Al acceder o utilizar el sitio web y servicios de Circuito Ocho, usted acepta cumplir y estar sujeto a los siguientes términos y condiciones.</p>
            <h3 class="text-xl font-bold text-white mt-6">1. Uso del Servicio</h3>
            <p>Nuestros servicios están disponibles únicamente para empresas y profesionales que busquen consultoría de marketing estratégico. Usted se compromete a utilizar el Servicio de manera legal y no infringir derechos de terceros ni las leyes aplicables.</p>
            <h3 class="text-xl font-bold text-white mt-6">2. Propiedad Intelectual</h3>
            <p>Todo el contenido presente en este sitio (textos, logotipos, gráficos, código, software) es propiedad exclusiva de Circuito Ocho o sus licenciantes y está protegido por leyes de derechos de autor. Queda estrictamente prohibida la reproducción sin autorización previa por escrito.</p>
            <h3 class="text-xl font-bold text-white mt-6">3. Limitación de Responsabilidad</h3>
            <p>Circuito Ocho proporciona este Servicio "tal cual" y no garantiza resultados específicos de marketing, incrementos de ROI o posicionamiento en motores de búsqueda. En la medida máxima permitida por la ley, no seremos responsables de daños indirectos, incidentales o consecuentes derivados del uso del Servicio.</p>
            <h3 class="text-xl font-bold text-white mt-6">4. Honorarios y Pagos</h3>
            <p>Los servicios contratados están sujetos a los precios publicados o pactados por escrito. Los pagos deben realizarse dentro de los plazos establecidos. Los impagos pueden resultar en la suspensión inmediata del servicio. Las tarifas no incluyen el presupuesto publicitario de plataformas externas (Meta, Google, etc.), el cual es responsabilidad del cliente.</p>
            <h3 class="text-xl font-bold text-white mt-6">5. Terminación</h3>
            <p>Podemos suspender o terminar su acceso al Servicio de inmediato, sin previo aviso ni responsabilidad, por cualquier razón, incluyendo el incumplimiento de estos Términos. Las cláusulas de propiedad intelectual y limitación de responsabilidad sobrevivirán a la terminación.</p>
            <h3 class="text-xl font-bold text-white mt-6">6. Ley Aplicable</h3>
            <p>Estos Términos se regirán por las leyes aplicables en la jurisdicción de operación de Circuito Ocho. Cualquier disputa derivada de estos términos se someterá a los tribunales competentes.</p>
            <h3 class="text-xl font-bold text-white mt-6">7. Modificaciones</h3>
            <p>Circuito Ocho se reserva el derecho de modificar estos términos en cualquier momento. El uso continuado del Servicio después de cambios constituye aceptación de los nuevos términos.</p>
            <p class="text-sm text-gray-400 mt-6">Última actualización: 10 de Abril de 2026</p>
        </div>
    </div>
</div>