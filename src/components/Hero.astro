---
import {
  translations,
  defaultLocale,
  type Locale
} from "@/i18n";

const locale: Locale = (Astro.props.lang as Locale) ?? defaultLocale;
const t = translations[locale];
---

<section class="relative min-h-screen flex items-center justify-center pt-20 overflow-hidden">
        <canvas id="bg-canvas" class="fixed"></canvas>

        <div class="container mx-auto px-6 relative z-10">
            <div class="max-w-4xl mx-auto text-center">
                <div class="hero-animate hero-animate-delay-1 mb-8">
                    <div class="status-badge">
                        <div class="status-dot"></div>
                        <span>{t.hero.status}</span>
                    </div>
                </div>

                <h1 class="hero-animate hero-animate-delay-1 text-5xl md:text-7xl lg:text-8xl font-bold mb-6 leading-tight">
                    Activa la <span class="text-c8-green glow-text">evolución</span><br>de tu marca
                </h1>

                <p class="hero-animate hero-animate-delay-2 text-xl md:text-2xl text-gray-300 mb-10 font-light max-w-2xl mx-auto">{t.hero.operate}</p>

                <div class="hero-animate hero-animate-delay-3 flex flex-col sm:flex-row gap-4 justify-center">
                    <a href="#contacto" class="btn-neon bg-c8-green text-c8-dark px-8 py-4 rounded font-mono font-bold hover:bg-white transition-colors text-lg">
                        INICIAR AUDITORÍA
                    </a>
                    <a href="#sistema" class="border border-c8-green/50 text-c8-green px-8 py-4 rounded font-mono font-bold hover:bg-c8-green/10 hover:border-c8-green transition-colors text-lg">
                        EXPLORAR LÓGICA
                    </a>
                </div>
            </div>
        </div>

        <div class="absolute bottom-10 left-1/2 transform -translate-x-1/2 scroll-indicator">
            <svg class="w-6 h-6 text-c8-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
            </svg>
        </div>
    </section>