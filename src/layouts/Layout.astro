---
import "@/styles/tailwind.css";
import "@/styles/themes/c8.css"
import "@/styles/style.css";
import SEO from "@/components/SEO.astro";
import { C8 } from "@/config";

import Analytics from "@/components/Analytics.astro";
import AnalyticsBody from "@/components/AnalyticsBody.astro";

const {
  title,
  description,
  canonical,
  lang = "es",
  type = "website",
  image = "/"
} = Astro.props;

---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content={C8.site.themeColor}>
    <meta name="author" content="Circuito Ocho">
    <meta name="generator" content={Astro.generator} />
    
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content={lang === "es" ? "es_MX" : "en_US"} />

    <link rel="icon" type="image/png" href="/img/C8_logo0626_F4.png">
  
    <link
    rel="preload"
    as="style"
    href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
/>

<link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
/>


    <SEO
  title={title}
  description={description}
  canonical={canonical}
  lang={lang}
/>
<Analytics />

<meta
    name="c8-gtm-debug"
    content={C8.analytics.gtm ?? "UNDEFINED"}
/>

</head>
<body class="bg-c8-dark text-white font-sans">
      <AnalyticsBody />
        <slot />
</body>
</html>